{
  "expo": {
    "name": "vh-mess",
    "slug": "vh-mess",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/IIT-Kanpur.png",
    "scheme": "vhmess",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.vh-mess"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/IIT-Kanpur.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.vhmess"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/IIT-Kanpur.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
          // TODO: Once we sync the app theme to device default, then enable this to get the dark theme in start up
          // "dark": {
          //   "image": "./assets/IIT-Kanpur.png",
          //   "backgroundColor": "#0f172a"
          // }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa1307ac-1624-4d9a-8cc6-e1f12b53a3fe"
      }
    }
  }
}
